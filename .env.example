# Copy to .env and fill in what you use. Everything is optional except where noted.

# Where the SQLite database lives (libsql). Defaults to ./data/os-organizer.db
# Hosted: a Turso URL (libsql://…) plus its token.
DATABASE_URL=file:./data/os-organizer.db
DATABASE_AUTH_TOKEN=

# Sign-in for the web app. Required when deployed; locally the app stays open without them.
# SESSION_SECRET: any long random string, e.g. `openssl rand -base64 32`.
APP_PASSWORD=
SESSION_SECRET=

# Shared secret for the bot, Gmail script, cron and calendar feed. Required once the app is reachable from outside your machine.
INGEST_SECRET=

# GitHub: classic personal access token with `notifications` and `read:user` scopes.
GITHUB_TOKEN=

# Discord bot (runs with `pnpm bot`). Lives only in your own private server.
DISCORD_BOT_TOKEN=
DISCORD_INBOX_CHANNEL_ID=
DISCORD_GUILD_ID=
# Where the bot reaches the app
APP_URL=http://localhost:3000

# Alerts: a webhook URL from a channel in your own server (Channel settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
